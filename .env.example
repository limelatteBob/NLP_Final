# Copy this template to .env and fill credentials locally. Never commit .env.
DEEPSEEK_API_KEY=
EVOTASK_PROVIDER=deepseek
EVOTASK_BASE_URL=https://api.deepseek.com
EVOTASK_MODEL=SET_TO_COURSE_MODEL
EVOTASK_API_KEY_ENV=DEEPSEEK_API_KEY

# Structured-action workflow: disabled reduces reasoning latency; change if needed.
EVOTASK_THINKING_MODE=disabled
EVOTASK_API_TIMEOUT=120
EVOTASK_MAX_RESPONSE_TOKENS=4096
EVOTASK_MAX_MODEL_CALLS=80
EVOTASK_MAX_STEPS=100
EVOTASK_MAX_TASK_STEPS=20
EVOTASK_MAX_TASKS=16
EVOTASK_MAX_DELEGATE_DEPTH=3
EVOTASK_ACTIVE_TIMEOUT=900

# Python code executes only in Docker Linux containers.
EVOTASK_DOCKER_IMAGE=python:3.11-slim
EVOTASK_TOOL_TIMEOUT=30
# Generated outputs only; document uploads have no fixed byte limit.
EVOTASK_MAX_FILE_BYTES=262144
EVOTASK_MAX_OUTPUT_BYTES=65536

# Optional search and GitHub integrations. Keep blank until configured.
EVOTASK_SEARCH_PROVIDER=wikipedia
BRAVE_API_KEY=
EVOTASK_GITHUB_REMOTE=
EVOTASK_GITHUB_TOKEN=

# Web access. Localhost works without a token. Non-loopback binding requires
# an access token of at least 24 characters and explicit hostnames/IPs.
EVOTASK_WEB_ACCESS_TOKEN=
EVOTASK_WEB_ALLOWED_HOSTS=localhost,127.0.0.1
